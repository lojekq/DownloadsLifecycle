<ui:FluentWindow x:Class="DownloadsLifecycle.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:DownloadsLifecycle.Shell"
                 xmlns:f="clr-namespace:DownloadsLifecycle.Features"
                 Title="{x:Static l:AppInfo.Title}" Width="1100" Height="700" MinWidth="720" MinHeight="480"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{x:Static l:AppInfo.Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="12,0,12,0">
            <ui:InfoBar x:Name="ElevatedBar" Severity="Warning" IsClosable="False" Margin="0,0,0,8"
                        Title="{l:T Elevated.Title}" Message="{l:T Elevated.Message}" />
            <ui:InfoBar x:Name="UpdateBar" Severity="Informational" Margin="0,0,0,8" Title="{l:T Update.Title}">
                <ui:HyperlinkButton x:Name="UpdateLink" Content="{l:T Update.Open}" Padding="0" />
            </ui:InfoBar>
            <ui:InfoBar x:Name="NoticeBar" Severity="Warning" Margin="0,0,0,8" Title="{l:T Notice.Title}" />
        </StackPanel>

        <!-- App pages go into MenuItems; TargetPageTag is the page id for the page flag and Navigate("id") -->
        <ui:NavigationView x:Name="Nav" Grid.Row="2" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False" OpenPaneLength="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{l:T Page.Inbox}" Icon="{ui:SymbolIcon MailInbox24}"
                                       TargetPageType="{x:Type f:InboxPage}" TargetPageTag="inbox" />
                <ui:NavigationViewItem Content="{l:T Page.Files}" Icon="{ui:SymbolIcon DocumentMultiple24}"
                                       TargetPageType="{x:Type f:FilesPage}" TargetPageTag="files" />
                <ui:NavigationViewItem Content="{l:T Page.Journal}" Icon="{ui:SymbolIcon History24}"
                                       TargetPageType="{x:Type f:JournalPage}" TargetPageTag="journal" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T Page.Settings}" Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type l:SettingsPage}" TargetPageTag="settings" />
                <ui:NavigationViewItem Content="{l:T Page.About}" Icon="{ui:SymbolIcon Info24}"
                                       TargetPageType="{x:Type l:AboutPage}" TargetPageTag="about" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- "To Recycle Bin": 8 s to undo, whatever page it came from -->
        <Border x:Name="UndoBar" Grid.Row="3" Margin="24,0,24,16" Padding="16,8" CornerRadius="6" Visibility="Collapsed"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Delete24" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:TextBlock x:Name="UndoText" Grid.Column="1" VerticalAlignment="Center" FontTypography="BodyStrong" />
                <ui:Button x:Name="UndoButton" Grid.Column="2" Content="{l:T Inbox.Undo}" Icon="{ui:SymbolIcon ArrowUndo24}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
