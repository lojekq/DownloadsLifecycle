<UserControl x:Class="DownloadsLifecycle.Features.RulesSettings" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:DownloadsLifecycle.Shell">
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ui:TextBlock Text="{l:T Settings.Folder}" Style="{StaticResource Head}" Margin="0,0,0,8" />
        <ui:CardControl Icon="{ui:SymbolIcon Folder24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Settings.Folder.Watched}" />
                    <ui:TextBlock x:Name="FolderText" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="{l:T Settings.Folder.Open}" Click="OpenFolder" />
        </ui:CardControl>
        <!-- v1.0: extra watched folders -->
        <ItemsControl x:Name="ExtraList" />
        <WrapPanel Margin="0,4,0,0">
            <ui:Button Content="{l:T Folders.Add}" Icon="{ui:SymbolIcon FolderAdd24}" Click="AddFolder" Margin="0,0,8,0" />
            <ui:Button x:Name="TelegramButton" Content="{l:T Folders.Telegram}" Click="AddTelegram" Visibility="Collapsed" />
        </WrapPanel>
        <ui:InfoBar x:Name="StorageSenseBar" Severity="Warning" IsClosable="False" Margin="0,8,0,0" Title="{l:T StorageSense.Title}" />

        <ui:TextBlock Text="{l:T SiteRules.Title}" Style="{StaticResource Head}" />
        <ui:TextBlock Text="{l:T SiteRules.Note}" Style="{StaticResource Note}" Margin="0,0,0,8" />
        <ItemsControl x:Name="RuleList" />
        <ui:Button Content="{l:T SiteRules.Add}" Icon="{ui:SymbolIcon Add24}" Click="AddRule" Margin="0,4,0,0" />

        <ui:TextBlock Text="{l:T Settings.Rules}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon CalendarClock24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Rules.Expired}" />
                    <ui:TextBlock Text="{l:T Rules.Expired.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ExpiredSwitch" AutomationProperties.Name="{l:T Rules.Expired}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon DocumentCopy24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Rules.Duplicates}" />
                    <ui:TextBlock Text="{l:T Rules.Duplicates.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="DuplicatesSwitch" AutomationProperties.Name="{l:T Rules.Duplicates}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon AppGeneric24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Rules.Installers}" />
                    <ui:TextBlock x:Name="InstallersNote" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="InstallersSwitch" AutomationProperties.Name="{l:T Rules.Installers}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon FolderZip24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Rules.Archives}" />
                    <ui:TextBlock x:Name="ArchivesNote" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ArchivesSwitch" AutomationProperties.Name="{l:T Rules.Archives}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon CalendarClock24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Rules.ExactDays}" />
                    <ui:TextBlock Text="{l:T Rules.ExactDays.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox x:Name="ExactDaysBox" AutomationProperties.Name="{l:T Rules.ExactDays}" Minimum="1" Maximum="365" MaxDecimalPlaces="0" Width="130" ClearButtonEnabled="False" />
        </ui:CardControl>

        <ui:TextBlock Text="{l:T Settings.Safety}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Safety.Grace}" />
                    <ui:TextBlock Text="{l:T Safety.Grace.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox x:Name="GraceBox" AutomationProperties.Name="{l:T Safety.Grace}" Minimum="0" Maximum="720" MaxDecimalPlaces="0" Width="130" ClearButtonEnabled="False" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Safety.MaxSize}" />
                    <ui:TextBlock Text="{l:T Safety.MaxSize.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox x:Name="MaxSizeBox" AutomationProperties.Name="{l:T Safety.MaxSize}" Minimum="0" Maximum="1024" MaxDecimalPlaces="1" Width="130" ClearButtonEnabled="False" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Safety.Mass}" />
                    <ui:TextBlock Text="{l:T Safety.Mass.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox x:Name="MassBox" AutomationProperties.Name="{l:T Safety.Mass}" Minimum="1" Maximum="1000" MaxDecimalPlaces="0" Width="130" ClearButtonEnabled="False" />
        </ui:CardControl>

        <ui:TextBlock Text="{l:T Settings.Reminder}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Settings.Reminder.Daily}" />
                    <ui:TextBlock Text="{l:T Settings.Reminder.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TimeBox" AutomationProperties.Name="{l:T Settings.Reminder.Daily}" Width="100" Margin="0,0,12,0" />
                <ui:ToggleSwitch x:Name="ReminderSwitch" AutomationProperties.Name="{l:T Settings.Reminder.Daily}" />
            </StackPanel>
        </ui:CardControl>

        <ui:TextBlock Text="{l:T Settings.Menu}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon ContentView24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Settings.Menu.Switch}" />
                    <ui:TextBlock Text="{l:T Settings.Menu.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="MenuSwitch" AutomationProperties.Name="{l:T Settings.Menu.Switch}" />
        </ui:CardControl>
    </StackPanel>
</UserControl>
