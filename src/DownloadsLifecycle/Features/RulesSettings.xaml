<UserControl x:Class="DownloadsLifecycle.Features.RulesSettings" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:DownloadsLifecycle.Shell">
    <UserControl.Resources>
        <Style x:Key="Head" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,8" />
        </Style>
        <Style x:Key="Note" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ui:TextBlock Text="{l:T Settings.Folder}" Style="{StaticResource Head}" Margin="0,0,0,8" />
        <ui:CardControl Icon="{ui:SymbolIcon Folder24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Settings.Folder.Watched}" />
                    <ui:TextBlock x:Name="FolderText" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="{l:T Settings.Folder.Open}" Click="OpenFolder" />
        </ui:CardControl>

        <ui:TextBlock Text="{l:T Settings.Rules}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon CalendarClock24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Rules.Expired}" />
                    <ui:TextBlock Text="{l:T Rules.Expired.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ExpiredSwitch" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon DocumentCopy24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Rules.Duplicates}" />
                    <ui:TextBlock Text="{l:T Rules.Duplicates.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="DuplicatesSwitch" />
        </ui:CardControl>

        <ui:TextBlock Text="{l:T Settings.Safety}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Safety.Grace}" />
                    <ui:TextBlock Text="{l:T Safety.Grace.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox x:Name="GraceBox" Minimum="0" Maximum="720" MaxDecimalPlaces="0" Width="130" ClearButtonEnabled="False" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Safety.MaxSize}" />
                    <ui:TextBlock Text="{l:T Safety.MaxSize.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox x:Name="MaxSizeBox" Minimum="0" Maximum="1024" MaxDecimalPlaces="1" Width="130" ClearButtonEnabled="False" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Safety.Mass}" />
                    <ui:TextBlock Text="{l:T Safety.Mass.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox x:Name="MassBox" Minimum="1" Maximum="1000" MaxDecimalPlaces="0" Width="130" ClearButtonEnabled="False" />
        </ui:CardControl>

        <ui:TextBlock Text="{l:T Settings.Reminder}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Settings.Reminder.Daily}" />
                    <ui:TextBlock Text="{l:T Settings.Reminder.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TimeBox" Width="100" Margin="0,0,12,0" />
                <ui:ToggleSwitch x:Name="ReminderSwitch" />
            </StackPanel>
        </ui:CardControl>

        <ui:TextBlock Text="{l:T Settings.Menu}" Style="{StaticResource Head}" />
        <ui:CardControl Icon="{ui:SymbolIcon ContentView24}" Margin="0,0,0,4">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock Text="{l:T Settings.Menu.Switch}" />
                    <ui:TextBlock Text="{l:T Settings.Menu.Note}" Style="{StaticResource Note}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="MenuSwitch" />
        </ui:CardControl>
    </StackPanel>
</UserControl>
